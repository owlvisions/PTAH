e}.status.good{border-color:#2f7756;color:var(--good)}.status.bad{border-color:#8a4141;color:var(--bad)}.hash{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:14px 0}.stat{padding:12px;background:#0c1428;border:1px solid var(--line);border-radius:10px}.stat strong{display:block;font-size:22px}.stat span{color:var(--muted);font-size:12px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.output{background:#070c17;border:1px solid var(--line);border-radius:10px;padding:14px;white-space:pre-wrap;overflow:auto;max-height:460px;min-height:120px;font:12px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.hidden{display:none!important}footer{padding:0 24px 24px;text-align:center;color:var(--muted);font-size:12px}@media(max-width:850px){.layout{grid-template-columns:1fr}.section-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
+</style>
+</head>
+<body>
+<header><div><h1>PTAH <span style="color:var(--accent)">/ بتاح</span></h1><div class="sub">Local investigation workbench · evidence-first reverse engineering</div></div><div class="pill">LOCAL ONLY · NO TARGET EXECUTION</div></header>
+<main class="layout">
+<aside class="stack">
+<section class="panel"><h2>1. Start an investigation</h2><p class="muted">Choose a file. It is uploaded only to this loopback server's temporary workspace and deleted when the server stops.</p><form id="initForm" class="fields"><label>Target file<input id="targetFile" type="file" required></label><button type="submit">Fingerprint & initialize</button></form><div id="targetInfo" class="status" style="margin-top:12px">No target loaded.</div></section>
+<section class="panel"><h2>2. Add evidence</h2><form id="evidenceForm" class="fields"><label>Evidence ID<input name="id" placeholder="ev-001" required></label><label>Kind<select name="kind"><option>static-analysis</option><option>runtime-observation</option><option>decompilation</option><option>symbol</option><option>network-observation</option><option>filesystem-observation</option><option>documentation</option><option>test-result</option><option>other</option></select></label><label>Summary<textarea name="summary" placeholder="What was observed?" required></textarea></label><label>Source reference<input name="source" placeholder="objdump output, file section, URL…" required></label><label>Confidence<select name="confidence"><option>observed</option><option>derived</option><option>inferred</option></select></label><button type="submit">Save evidence</button></form></section>
+<section class="panel"><h2>3. Run static metadata analysis</h2><p class="muted">Uses allow-listed objdump or wasm-tools adapters with a timeout and output cap. This runs the analyzer, not the target program. It is not OS-sandboxed.</p><form id="analyzeForm" class="fields"><label>Provider<select name="provider"><option value="objdump">GNU objdump</option><option value="llvm-objdump">LLVM objdump</option><option value="wasm-tools">wasm-tools (WebAssembly validation)</option></select></label><label>Evidence ID (optional)<input name="evidenceId" placeholder="generated automatically if empty"></label><button type="submit">Analyze file metadata</button></form></section>
+</aside>
+<div class="stack">
+<section class="panel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><h2 style="margin:0">Investigation overview</h2><div class="actions"><a id="download" class="button secondary hidden" href="/api/download">Export JSON</a><button id="refresh" class="secondary" type="button">Refresh</button></div></div><div class="stats"><div class="stat"><strong id="evidenceCount">0</strong><span>Evidence items</span></div><div class="stat"><strong id="claimCount">0</strong><span>Claims</span></div><div class="stat"><strong id="questionCount">0</strong><span>Questions</span></div><div class="stat"><strong id="actionCount">0</strong><span>Candidate actions</span></div></div><div id="status" class="status">Upload a target to begin.</div><div id="summary" class="output" style="margin-top:12px">No investigation yet.</div></section>
+<div class="section-grid">
+<section class="panel"><h2>Add a claim</h2><form id="claimForm" class="fields"><label>Claim ID<input name="id" placeholder="claim-001" required></label><label>Claim text<textarea name="text" required></textarea></label><label>Evidence IDs (comma-separated)<input name="evidenceIds" placeholder="ev-001" required></label><label>Status<select name="status"><option>hypothesis</option><option>supported</option><option>verified</option><option>rejected</option></select></label><button type="submit">Save claim</button></form></section>
+<section class="panel"><h2>Track an open question</h2><form id="questionForm" class="fields"><label>Question ID<input name="id" placeholder="q-001" required></label><label>Question<textarea name="text" required></textarea></label><label>Priority (0–100)<input name="priority" type="number" min="0" max="100" value="50"></label><label>Required evidence kinds<input name="requiredEvidenceKinds" placeholder="runtime-observation,documentation"></label><button type="submit">Save question</button></form></section>
+<section class="panel"><h2>Plan a candidate action</h2><form id="actionForm" class="fields"><label>Action ID<input name="id" placeholder="a-001" required></label><label>Action name<input name="name" required></label><label>Produces evidence kinds<input name="produces" placeholder="runtime-observation" required></label><label>Estimated cost<input name="cost" type="number" min="0.01" step="0.01" value="1"></label><button type="submit">Save action</button></form></section>
+<section class="panel"><h2>Inspect outputs</h2><div class="actions"><button data-output="report" type="button">Evidence report</button><button data-output="graph" type="button" class="secondary">Evidence graph</button><button data-output="plan" type="button" class="secondary">Next-step plan</button></div><div id="output" class="output" style="margin-top:12px">Choose a report, graph, or plan.</div></section>
+</div>
+</div>
+</main>
+<footer>PTAH migration preview · data stays in a temporary local workspace · review evidence provenance before trusting conclusions.</footer>
+<script>
+const $=id=>document.getElementById(id);const state={initialized:false};
+function showStatus(message,kind=''){const el=$('status');el.textContent=message;el.className='status '+kind}
+function showError(error){showStatus(error.message||String(error),'bad')}
+async function api(url,options={}){const response=await fetch(url,options);const type=response.headers.get('content-type')||'';const data=type.includes('json')?await response.json():await response.text();if(!response.ok)throw new Error(data.error||data.analysis?.error||`Request failed (${response.status})`);return data}
+function formObject(form){return Object.fromEntries(new FormData(form).entries())}
+function split(value){return String(value||'').split(',').map(v=>v.trim()).filter(Boolean)}
+function render(investigation,target){state.initialized=!!investigation;$('download').classList.toggle('hidden',!state.initialized);$('evidenceCount').textContent=investigation?.evidence?.length||0;$('claimCount').textContent=investigation?.claims?.length||0;$('questionCount').textContent=investigation?.questions?.length||0;$('actionCount').textContent=investigation?.actions?.length||0;if(target){$('targetInfo').innerHTML='';const name=document.createElement('div');name.textContent=target.name;const hash=document.createElement('div');hash.className='hash';hash.textContent=target.sha256;$('targetInfo').append(name,hash);$('targetInfo').classList.add('good')}if(investigation){$('summary').textContent=JSON.stringify({schemaVersion:investigation.schemaVersion,target:investigation.target,evidence:investigation.evidence,claims:investigation.claims,questions:investigation.questions,actions:investigation.actions},null,2);showStatus('Investigation loaded and schema-validated.','good')}else{$('summary').textContent='No investigation yet.'}}
+async function refresh(){try{const data=await api('/api/state');render(data.investigation,data.target)}catch(e){showError(e)}}
+$('initForm').addEventListener('submit',async e=>{e.preventDefault();try{const file=$('targetFile').files[0];if(!file)throw new Error('Choose a file first.');showStatus('Fingerprinting uploaded bytes…');const data=await api('/api/init',{method:'POST',headers:{'content-type':'application/octet-stream','x-target-name':file.name},body:file});render(data.investigation,data.target)}catch(err){showError(err)}});
+$('evidenceForm').addEventListener('submit',async e=>{e.preventDefault();try{const data=formObject(e.currentTarget);await api('/api/evidence',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});e.currentTarget.reset();await refresh()}catch(err){showError(err)}});
+$('claimForm').addEventListener('submit',async e=>{e.preventDefault();try{const data=formObject(e.currentTarget);data.evidenceIds=split(data.evidenceIds);await api('/api/claim',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});e.currentTarget.reset();await refresh()}catch(err){showError(err)}});
+$('questionForm').addEventListener('submit',async e=>{e.preventDefault();try{const data=formObject(e.currentTarget);data.priority=Number(data.priority);data.requiredEvidenceKinds=split(data.requiredEvidenceKinds);await api('/api/question',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});e.currentTarget.reset();await refresh()}catch(err){showError(err)}});
+$('actionForm').addEventListener('submit',async e=>{e.preventDefault();try{const data=formObject(e.currentTarget);data.cost=Number(data.cost);data.produces=split(data.produces);await api('/api/action',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});e.currentTarget.reset();await refresh()}catch(err){showError(err)}});
+$('analyzeForm').addEventListener('submit',async e=>{e.preventDefault();try{const data=formObject(e.currentTarget);if(!data.evidenceId)delete data.evidenceId;showStatus('Running bounded static metadata analysis…');const result=await api('/api/analyze',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});$('output').textContent=JSON.stringify(result.analysis,null,2);render(result.investigation,{name:result.investigation.target.id,sha256:result.investigation.target.sha256})}catch(err){showError(err)}});
+$('refresh').addEventListener('click',refresh);document.querySelectorAll('[data-output]').forEach(button=>button.addEventListener('click',async()=>{try{$('output').textContent=JSON.stringify(await api(`/api/${button.dataset.output}`),null,2)}catch(e){showError(e)}}));refresh();
+</script>
