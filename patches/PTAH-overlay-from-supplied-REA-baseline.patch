@@ -0,0 +1,125 @@
+name: PTAH upstream sync
+
+on:
+  schedule:
+    # GitHub Actions schedules have a 5-minute minimum interval. This checks
+    # upstream frequently without claiming a hard real-time delivery SLA.
+    - cron: '*/15 * * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+
+concurrency:
+  group: ptah-upstream-sync-${{ github.repository }}
+  cancel-in-progress: false
+
+jobs:
+  propose-upstream-update:
+    # Never run this automation against the upstream project itself.
+    if: github.repository != 'morluto/rea'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - name: Check out the PTAH fork with full history
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          fetch-depth: 0
+
+      - name: Set up supported Node.js
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: '22.19.0'
+
+      - name: Rebase PTAH changes onto the latest REA main
+        id: sync
+        env:
+          BASE_BRANCH: ${{ github.event.repository.default_branch }}
+          SYNC_BRANCH: bot/ptah-upstream-sync
+        shell: bash
+        run: |
+          set -euo pipefail
+          git config user.name 'github-actions[bot]'
+          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+          git remote add upstream https://github.com/morluto/rea.git || git remote set-url upstream https://github.com/morluto/rea.git
+          git fetch --no-tags upstream main
+          git fetch origin "${BASE_BRANCH}"
+
+          base_ref="origin/${BASE_BRANCH}"
+          upstream_sha="$(git rev-parse upstream/main)"
+          echo "upstream_sha=${upstream_sha}" >> "$GITHUB_OUTPUT"
+
+          if ! git merge-base upstream/main "$base_ref" >/dev/null 2>&1; then
+            {
+              echo '### PTAH upstream sync is not bootstrapped yet'
+              echo
+              echo 'The default branch and upstream/main do not share Git history. This commonly happens when the project was uploaded from a ZIP archive. The workflow will not attempt a destructive or conflict-prone rebase.'
+              echo
+              echo 'Bootstrap the repository from the REA Git history, apply and review `patches/PTAH-overlay-from-supplied-REA-baseline.patch`, push the resulting history, then rerun this workflow.'
+              echo
+              echo 'See `docs/PTAH-UPSTREAM-SYNC.md` for the safe bootstrap procedure.'
+            } >> "$GITHUB_STEP_SUMMARY"
+            echo 'changed=false' >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          if git merge-base --is-ancestor upstream/main "$base_ref"; then
+            echo 'Upstream is already contained in the default branch; no sync PR needed.'
+            echo 'changed=false' >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          git checkout -B "$SYNC_BRANCH" "$base_ref"
+          if ! git rebase upstream/main; then
+            git rebase --abort || true
+            {
+              echo '### PTAH upstream sync needs manual conflict resolution'
+              echo
+              echo "The latest upstream commit is \`${upstream_sha}\`. Rebase stopped because one or more PTAH changes overlap upstream changes. No branch was pushed and the default branch was not modified."
+              echo
+              echo 'Resolve this in a clone with `git fetch upstream && git rebase upstream/main`, then rerun this workflow.'
+            } >> "$GITHUB_STEP_SUMMARY"
+            echo 'changed=false' >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          if git diff --quiet "$base_ref" HEAD; then
+            echo 'Rebase produced no tree changes; no sync PR needed.'
+            echo 'changed=false' >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          echo 'changed=true' >> "$GITHUB_OUTPUT"
+          echo "Rebased onto upstream ${upstream_sha}"
+
+      - name: Validate PTAH-specific JavaScript and tests
+        if: steps.sync.outputs.changed == 'true'
+        run: |
+          node --check scripts/ptah.mjs
+          node --check scripts/ptah-engine.mjs
+          node --check scripts/ptah-mcp.mjs
+          node --check scripts/ptah-ui.mjs
+          node --check scripts/ptah-ui-server.mjs
+          npm run test:ptah
+
+      - name: Publish sync branch and open or update review PR
+        if: steps.sync.outputs.changed == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          BASE_BRANCH: ${{ github.event.repository.default_branch }}
+          SYNC_BRANCH: bot/ptah-upstream-sync
+          UPSTREAM_SHA: ${{ steps.sync.outputs.upstream_sha }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          git push --force origin "HEAD:refs/heads/${SYNC_BRANCH}"
+          pr_number="$(gh pr list --base "$BASE_BRANCH" --head "$SYNC_BRANCH" --state open --json number --jq '.[0].number // empty')"
+          body="$(printf '%s\n\n%s\n' \
+            "Automated proposal to rebase PTAH changes onto morluto/rea@${UPSTREAM_SHA:0:12}." \
+            "This PR is review-only and does not auto-merge upstream code. PTAH-specific syntax checks and tests run first; the full REA monorepo validation matrix must pass before merging. Conflicts stop the sync without rewriting the default branch.")"
+          if [[ -n "$pr_number" ]]; then
+            gh pr edit "$pr_number" --title "chore: sync latest REA upstream" --body "$body"
+          else
+            gh pr create --base "$BASE_BRANCH" --head "$SYNC_BRANCH" --title "chore: sync latest REA upstream" --body "$body"
+          fi
